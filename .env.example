# 값은 비워 둔다. 실제 값은 .env(git 제외)에만 넣는다.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# Jev 모델(고정)
TYPESAFE_DEFAULT_MODEL=jev-1.14.0

# 답 · 채점 · 이름 뽑기 모델
ANSWER_MODEL=claude-sonnet-5-5
JUDGE_MODEL=claude-opus-5-5
EXTRACT_MODEL=claude-opus-5-5

# 허브(SPEC-005) 주소
HUB_GOLD_MCP_URL=http://127.0.0.1:18005/procedure-hub/gold-mcp/mcp
HUB_RAW_MCP_URL=http://127.0.0.1:18005/procedure-hub/raw-mcp/mcp
HUB_REST_URL=http://127.0.0.1:18005/procedure-hub/gold

# 레포 밖 데이터 경로 — 사용자가 .env 에서 채운다(원장 21 폴더 · semantic.json)
RAW_DIR=
SEMANTIC_JSON=

# 기록 폴더(ignore 된 runs/ 또는 레포 밖)
RUNS_DIR=./runs

# 실험 서버 포트(127.0.0.1 에만)
CLINIC_CHAT_PORT=18210

# case1 · 2 도구 루프 상한(Sonnet 호출 수)
CASE_TOOL_LOOP_MAX=12

# Jev 낮은 신뢰 표시 문턱
JEV_CONFIDENCE_MIN=0.3

# sdk 판 도구 · 허브 결과 입력 상한(바이트 · 0 = 없음 — 허브 응답 전체를 모델에 · SPEC-006 v2 §2-5)
TOOL_RESULT_MAX_BYTES=0

# 도구 결과 전달 보장(§3-5) — 허브 MCP 도구 meta 와 같은 값 · Claude MAX_MCP_OUTPUT_TOKENS · Codex 토큰 한도
MCP_RESULT_MAX_CHARS=200000

# case3 Jev 걸음(§3-4) — 걸음 상한(0 = v1 경로만) · 펼친 바이트 예산 · 「충분」 Noul 문턱
WALK_MAX_STEPS=4
WALK_BYTE_BUDGET=20000
WALK_ENOUGH_MIN=0.8
# 걷기 고침 2(11-01) — 모은 바이트가 예산의 이 비율 미만이면 「충분」 무시 · 필수 묶음 섹션 · 받을 시술 수 · 의도별 고정 섹션
WALK_ENOUGH_BYTES_RATIO=0.8
# 걷기 고침 3(11-01) — Jev 는 이웃만 · 걷는 노드마다 의도 묶음 · 남은 예산 채우기
WALK_JEV_SECTIONS=false
WALK_BASE_BUNDLE=true
WALK_FILL=true
# 걷기 고침 4(11-01) — 안전 예산(20KB 밖 · 필수 묶음 + 시술 위 3 의 부작용 · 합병증) · 0 이면 일반 예산에서
WALK_SAFETY_BUDGET=8000
WALK_SAFETY_SECTIONS_CSV=safety.side_effects,safety.complications
WALK_REQUIRED_SECTIONS_CSV=checks,site_caution
WALK_REQUIRED_MAX=3
WALK_FIXED_SECTIONS_BY_INTENT=I-02:overview+method,I-03:aftercare+recovery,I-04:safety.side_effects+safety.complications+safety.management,I-05:recovery+timeline,I-07:evidence,I-08:evidence
# v2.2~v2.4 걸음 규칙(SPEC-006 §3-4-1 · §3-4-6) — 걸음당 섹션 · 이웃 · 걸음 1 섹션 상한(의도별) · cut 줄 원문 예산 · 원문 줄 수
WALK_SECTIONS_PER_STEP=2
WALK_NEIGHBORS_MAX=3
WALK_FIRST_SECTION_MAX=1
WALK_FIRST_SECTION_MAX_BY_INTENT=I-02:2,I-03:2,I-04:2,I-05:2
WALK_FULL_BYTE_BUDGET=15000
WALK_FULL_FACTS_MAX=64
# 걸음 1 이웃 순서 표(비면 앱 안 clinic_chat/cases/walk_order.json — spec006-v24-recount.json order_v24 복사본)
WALK_ORDER_TABLE=

# ① 이름 뽑기 · ② 채점 자동 실행(기본 끔 — 화면 「채점」 버튼)
AUTO_QUALITY=false

# CLI provider(실험 — 구독 인증. API 키는 자식 프로세스에 넘기지 않음)
DEFAULT_PROVIDER=claude-cli
CLAUDE_CLI_MODEL=claude-sonnet-5-5
CLAUDE_CLI_EFFORT=medium
CODEX_CLI_MODEL=gpt-5.6-terra
CODEX_CLI_EFFORT=medium
CODEX_SERVICE_TIER=
CLI_TIMEOUT_SEC=600
CLI_MAX_BUDGET_USD=1.0
JUDGE_PROVIDER=claude-cli
JUDGE_CLI_EFFORT=medium
EXTRACT_CLI_EFFORT=low
JUDGE_MAX_BUDGET_USD=3.0

# 일괄 실행 — 사용자가 정함(비면 배치를 시작하지 않음)
BATCH_GAP_SEC=
BATCH_RETRIES=
BATCH_RETRY_BACKOFF_SEC=
BATCH_LIMIT_WAIT_SEC=
# 질문 리스트 파일(사용자 경로 — .env 에서 채움)
QUESTIONS_MD=
CLI_MAX_CONCURRENT=6
