# 값은 비워 둔다. 실제 값은 .env(git 제외)에만 넣는다.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=

# ── 이름만 덧붙임(WORK-002 §2-5) — 값은 .env 에만 ──
# Jev — 실제 model id 로 고정 권장(E1 11-16 응답 = jev-1.14.0)
TYPESAFE_DEFAULT_MODEL=
# LLM(CLI 구독 · claude -p) — ANSWER_MODEL = sonnet | haiku · JUDGE_MODEL 기본 opus
ANSWER_MODEL=
JUDGE_MODEL=
CLAUDE_CLI_EFFORT=
CLI_TIMEOUT_SEC=
CLI_MAX_CONCURRENT=
# ANSWER_REASONING = off | lowest_effort — E2 · E5(11-16, CLI 2.1.322) 결과: claude --help 에 「추론 끔」 플래그가 없고,
# --settings {"alwaysThinkingEnabled":false} + MAX_THINKING_TOKENS=0 을 줘도 실제 B 단계 ⑤ 입력에서 thinking 블록이 나왔다
# → 기본 lowest_effort(--effort low). off 는 그 두 설정을 더하는 꼴로 남겨 둠(기록 llm_pages[].thinking_seen 으로 확인)
ANSWER_REASONING=
# 허브(로컬 18105)
HUB_REST_URL=
HUB_GOLD_MCP_URL=
HUB_PAGE_LIMIT=
HUB_COMMIT=
HUB_WORKTREE=
# A 열 원장 폴더(원장 JSON 이 있는 폴더)
RAW_DIR=
# 걷기 문턱 — 전부 임시값(1회차 trace 로 보정 · 대상 · 정보 종류 · 깊이 · 입구가 같은 문턱 — SPEC-002 §3-4)
JEV_NOUL_YES_AT=
JEV_NOUL_NO_AT=
# KD10(SPEC-002 0.6) — 사이 값 가운데 이 값 이상인 정보 종류는 읽는다 · 임시값 0.5(추가 문항으로 다시 본다)
JEV_KIND_READ_AT=0.5
JEV_BATCH_SIZE=
WALK_MAX_STEPS=
ANSWER_INPUT_MAX_TOKENS=
# 세트 · 채점(답을 만드는 세 열의 자식 프로세스에는 주지 않는다)
EVAL_SET_DIR=
QUESTIONS_CSV=
GOLD_CSV_DIR=
LEDGER_CHECK_PATH=
# 기록
RUNS_DIR=
BATCH_PAUSE_SEC=
# 상담 채팅(SPEC-004 §2-4 · WORK-011 §7) — 비우면 기본값
# 포트(기본 18222) · CLI 모델 · 대체 모델 · effort · 한 턴 CLI 시간 한도(초) · 대화 턴 한도 · 이어 묻기에서 되짚는 앞 턴 수
CHAT_PORT=
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
CHAT_EFFORT=
CHAT_TURN_TIMEOUT_SEC=
CHAT_MAX_TURNS=
CHAT_CARRY_TURNS=
# 장부 자리(기본 RUNS_DIR/consult) · CLI 고정 cwd(기본 사용자 캐시 폴더 아래 clinic-chat/consult-cli — 레포 밖)
CHAT_DIR=
CHAT_CLI_CWD=
# 상담 프롬프트 파일(기본 prompts/consult.json) · 가짜 턴(E0 · 시험 전용 — 외부 호출 0)
CHAT_PROMPT_FILE=
CHAT_FAKE_TURN=
# 상담 0.2(SPEC-005 §10-2) — 상담 객체 손잡이. 기본 off(= 0.1 그대로). CHAT_STATE 는 이 파일에 두지 말고
# 프로세스 env 로만 켠다(예: CHAT_STATE=on uv run python -m clinic_chat.consult) · 대화는 첫 턴의 값으로 끝까지 돈다
# 같은 빈 칸을 주는 횟수 한도(기본 2) · 시너지 먼저(기본 on) · 거둠 Noul(기본 on) — 뒤 셋은 켠 상태에서만 쓰인다
CHAT_ASK_MAX=
CHAT_SYNERGY=
CHAT_RETRACT=
# 상담 0.3(SPEC-006 §10-2) — 켠 상태(rev 3)의 손잡이 · 비우면 코드 기본값
CHAT_TURN_KIND=
CHAT_TALK_MAX=
CHAT_ALT_MAX=
CHAT_VOICE_CHECK=
CHAT_DEBUG_PANEL=
CHAT_DRAWER_MAX=
# 상담 0.4(SPEC-008 §4-2) — 이해 호출(소넷 하나 · 목록 = 허브 resolve 목록 꼴). CHAT_STATE 기본 on · off 여도 새 대화는 켠 상태
# (옛 끈 대화는 읽기만). 비우면 코드 기본값: sonnet · low · off · 10 · on · on · 2 · 200 · 30
CHAT_PICK_MODEL=
CHAT_PICK_EFFORT=
CHAT_PICK_THINKING=
CHAT_PICK_TIMEOUT_SEC=
CHAT_PICK_ALIASES=
CHAT_PICK_LIST_CACHE=
CHAT_PICK_CONTEXT_TURNS=
CHAT_PICK_ANSWER_CHARS=
CHAT_PICK_LIST_MAX=
